# 后台管理相关配置
# admin 登录验证码，启用或禁用后台登录时的验证码功能
ADMIN_LOGIN_CAPTCHA=true
# admin https，启用或禁用后台HTTPS安全连接
ADMIN_HTTPS=false
# admin开发工具，显示或隐藏后台开发工具
ADMIN_SHOW_DEVELOPMENT_TOOLS=true
# 显示自动生成权限按钮，在权限管理界面显示自动生成权限的按钮
ADMIN_SHOW_AUTO_GENERATE_PERMISSION_BUTTON=true

# 认证系统配置
# Auth JWT Redis，是否将JWT令牌存储在Redis中
AUTH_JWT_REDIS=false
# Auth 管理员模型，指定管理员用户模型的命名空间路径
AUTH_ADMIN_MODEL=warm\admin\model\AdminUser

# 数据库连接配置
# DB_CONNECTION，指定默认数据库连接类型
DB_CONNECTION=mysql
# DB_HOST，数据库服务器主机地址
DB_HOST=127.0.0.1
# DB_PORT，数据库服务器端口号
DB_PORT=3306
# DB_DATABASE，数据库名称
DB_DATABASE=webman
# DB_USERNAME，数据库用户名
DB_USERNAME=root
# DB_PASSWORD，数据库密码
DB_PASSWORD=root
# DB_SOCKET，数据库Unix套接字（可选）
DB_SOCKET=
# MYSQL_ATTR_SSL_CA，MySQL SSL连接的CA证书路径（可选）
MYSQL_ATTR_SSL_CA=

# Redis缓存配置
# REDIS_HOST，Redis服务器主机地址
REDIS_HOST=127.0.0.1
# REDIS_PASSWORD，Redis服务器密码（如无密码可设为null）
REDIS_PASSWORD=null
# REDIS_PORT，Redis服务器端口号
REDIS_PORT=6379
# REDIS_CACHE_DB，Redis数据库编号（通常为0-15之间的数字）
REDIS_CACHE_DB=0

# API接口配置
# API请求日志，启用或禁用API请求日志记录
API_REQUEST_LOG_ENABLE=true
# API转换请求名称，启用或禁用请求参数名称的自动转换
API_CONVERT_REQUEST_NAME_ENABLE=false
# API转换响应名称，启用或禁用响应数据字段名称的自动转换
API_CONVERT_RESPONSE_NAME_ENABLE=false
# API SQL监控，启用或禁用SQL执行监控
API_SQL_MONITOR_ENABLE=false